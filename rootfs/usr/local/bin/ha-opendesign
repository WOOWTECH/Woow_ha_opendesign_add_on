#!/usr/bin/env bash
set -Eeuo pipefail

readonly DATA_DIR=/data/opendesign
readonly NGINX_TMP=/tmp/ha-opendesign-nginx
readonly OMNIGENT_KIT=/etc/omnigent-host
readonly SHUTDOWN_GRACE_SECONDS=5
# Supervised children. Every process started with start_child is required: when
# any one exits, the launcher stops the others and exits so Supervisor restarts
# the complete set. Add a process with one more start_child call below.
child_pids=()
child_names=()
stopping=0

terminate_children() {
  if (( stopping )); then
    return
  fi
  stopping=1
  trap - TERM INT
  local pid deadline
  for pid in "${child_pids[@]}"; do
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      kill -TERM "$pid" 2>/dev/null || true
    fi
  done

  deadline=$((SECONDS + SHUTDOWN_GRACE_SECONDS))
  while (( SECONDS < deadline )); do
    local alive=0
    for pid in "${child_pids[@]}"; do
      if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        alive=1
      fi
    done
    (( alive == 0 )) && break
    sleep 0.1
  done

  for pid in "${child_pids[@]}"; do
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      echo "[ha-opendesign] process $pid exceeded ${SHUTDOWN_GRACE_SECONDS}s grace; sending KILL" >&2
      kill -KILL "$pid" 2>/dev/null || true
    fi
  done
  for pid in "${child_pids[@]}"; do
    if [[ -n "$pid" ]]; then
      wait "$pid" 2>/dev/null || true
    fi
  done
}

trap terminate_children TERM INT

# start_child <name> <command...>: run a required process in the background.
start_child() {
  local name=$1
  shift
  "$@" &
  child_pids+=("$!")
  child_names+=("$name")
}

child_name() {
  local i
  for i in "${!child_pids[@]}"; do
    if [[ "${child_pids[$i]}" == "$1" ]]; then
      printf '%s' "${child_names[$i]}"
      return
    fi
  done
  printf 'unknown'
}

prepare_owned_dir() {
  local dir=$1
  if [[ -L "$dir" ]]; then
    echo "[ha-opendesign] refusing symbolic-link runtime directory: $dir" >&2
    exit 78
  fi
  if [[ -e "$dir" ]]; then
    if [[ ! -d "$dir" ]]; then
      echo "[ha-opendesign] runtime path is not a directory: $dir" >&2
      exit 78
    fi
  else
    # Parents are prepared first, so plain mkdir never traverses a child path
    # that has not already passed the no-symlink check.
    mkdir -- "$dir"
  fi
  if [[ -L "$dir" || ! -d "$dir" ]]; then
    echo "[ha-opendesign] runtime directory changed during validation: $dir" >&2
    exit 78
  fi
  # -h/--no-dereference prevents a late symlink swap from changing its target.
  chown -h open-design:open-design "$dir"
}

remove_obsolete_credentials() {
  local legacy_dir="$DATA_DIR/credentials"
  if [[ ! -e "$legacy_dir" && ! -L "$legacy_dir" ]]; then
    return
  fi

  # rm removes a symlink itself rather than following it. Check explicitly so a
  # legacy symlink is never treated as a directory, and never remove DATA_DIR.
  if [[ -L "$legacy_dir" ]]; then
    rm -f -- "$legacy_dir"
  else
    rm -rf -- "$legacy_dir"
  fi
}

if [[ $(id -u) -ne 0 ]]; then
  echo "[ha-opendesign] launcher must start as root to prepare the HA /data mount" >&2
  exit 78
fi

owned_dirs=(
  "$DATA_DIR"
  "$DATA_DIR/home"
  "$DATA_DIR/home/.omnigent"
  "$DATA_DIR/home/studio"
  "$DATA_DIR/shared"
  "$DATA_DIR/shared/skills"
  "$DATA_DIR/shared/mcp"
  "$DATA_DIR/shared/plugins"
  "$DATA_DIR/shared/workspaces"
  "$DATA_DIR/export-render"
  "$DATA_DIR/export-pdf"
  "$NGINX_TMP"
  "$NGINX_TMP/client"
  "$NGINX_TMP/proxy"
  "$NGINX_TMP/fastcgi"
  "$NGINX_TMP/uwsgi"
  "$NGINX_TMP/scgi"
)
for dir in "${owned_dirs[@]}"; do
  prepare_owned_dir "$dir"
done
for dir in "$DATA_DIR" "$DATA_DIR/home" "$DATA_DIR/export-render" "$DATA_DIR/export-pdf"; do
  [[ ! -L "$dir" && -d "$dir" ]] || {
    echo "[ha-opendesign] refusing unsafe chmod target: $dir" >&2
    exit 78
  }
  chmod 0750 "$dir"
done
# omnigent keeps its login (auth_tokens.json) here; it expects a 0700 directory.
chmod 0700 "$DATA_DIR/home/.omnigent"
# Agent CLI config homes (CODEX_HOME etc. below). Codex warns when its home is
# missing, so create the absent ones. Existing entries are the user's and are
# left exactly as they are (including symlinks): this never fails startup.
for dir in "$DATA_DIR/home/.claude" "$DATA_DIR/home/.codex" "$DATA_DIR/home/.config" \
  "$DATA_DIR/home/.pi" "$DATA_DIR/home/.pi/agent"; do
  if [[ ! -e "$dir" && ! -L "$dir" && -d "${dir%/*}" && ! -L "${dir%/*}" ]]; then
    mkdir -- "$dir" && chown -h open-design:open-design "$dir"
  fi
done
remove_obsolete_credentials

export OD_DATA_DIR="$DATA_DIR"
export OD_BIND_HOST=127.0.0.1
export OD_PORT=7456
export OD_DAEMON_URL=http://127.0.0.1:7456
export HOME="$DATA_DIR/home"
export HA_OPENDESIGN_HOME="$DATA_DIR/home"
export CLAUDE_CONFIG_DIR="$HOME/.claude"
export CODEX_HOME="$HOME/.codex"
export PI_CODING_AGENT_DIR="$HOME/.pi/agent"
export XDG_CONFIG_HOME="$HOME/.config"

# Omnigent host (woow-paas-charts shared/omnigent-host kit, baked into the image
# at /etc/omnigent-host instead of the chart's ConfigMap). The kit launcher runs
# its supervisor next to the OpenDesign daemon; the supervisor idles until a
# login exists (OpenDesign's native Omnigent dialog, or `omnigent login <url>`
# in the CLI Terminal) and then keeps `omnigent host` connected. These values
# are the chart's woow.omnigentHost.env contract for open-design, re-pointed at
# the persistent HA home. Exported for every child: the daemon's Omnigent
# integration and the terminal's `omnigent` guard read the same state.
export OMNIGENT_ANALYTICS=0
export DO_NOT_TRACK=1
export DISABLE_TELEMETRY=1
export OG_HOST_ENABLED=1
export OG_KIT_DIR="$OMNIGENT_KIT"
export OG_CONFIG_HOME="$HOME/.omnigent"
export OG_DATA_DIR="$HOME/.omnigent"
export OMNIGENT_CONFIG_HOME="$OG_CONFIG_HOME"
export OMNIGENT_DATA_DIR="$OG_DATA_DIR"
export OG_STATUS_FILE="$OG_DATA_DIR/omnigent-host/status.json"
export OG_HOST_NAME="Home Assistant OpenDesign"
export OG_WORKSPACE="$HOME/studio"
export OG_WATCH_SECONDS=120
export OG_BIN=/usr/local/bin/omnigent
export OG_PROVIDERS=claude-subscription
export OG_PASSTHROUGH="OD_DAEMON_URL,NODE_PATH,NODE_OPTIONS,PUPPETEER_EXECUTABLE_PATH,PUPPETEER_SKIP_DOWNLOAD,PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH,PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD,USE_BUILTIN_RIPGREP,CLAUDE_CONFIG_DIR,CODEX_HOME,PI_CODING_AGENT_DIR,XDG_CONFIG_HOME"
export OG_UNSET_ENV="OD_API_TOKEN"
export OMNIGENT_HOST_NO_OPEN=1
# Fit the kit's ordered stop (supervisor -> host -> daemon) inside this
# launcher's SHUTDOWN_GRACE_SECONDS and HA Supervisor's default stop timeout.
export OG_STOP_GRACE_SECONDS=2
export OG_LAUNCH_STOP_SECONDS=3

start_child opendesign \
  su-exec open-design:open-design /bin/sh "$OMNIGENT_KIT/omnigent-host-launch" -- \
  /usr/local/bin/node /opt/ha-opendesign/headless-entry.mjs
# `-e stderr` uses the inherited descriptor directly; reopening /dev/stderr is
# denied when HA's root PID 1 drops to UID 1001 under its container procfs.
start_child nginx \
  su-exec open-design:open-design /usr/sbin/nginx -e stderr -c /etc/nginx/nginx.conf
start_child ttyd \
  su-exec open-design:open-design /usr/bin/ttyd \
  --port 7681 --interface 127.0.0.1 --base-path /terminal \
  --writable --check-origin --max-clients 1 \
  --cwd "$HOME" /bin/bash --login

exited_pid=''
set +e
wait -n -p exited_pid "${child_pids[@]}"
status=$?
set -e

if (( stopping )); then
  # TERM/INT interrupted the wait; the trap has already stopped every child.
  echo "[ha-opendesign] stop requested (status=$status); all processes stopped" >&2
else
  echo "[ha-opendesign] required process $(child_name "${exited_pid:-}") exited (status=$status); stopping its peers" >&2
  terminate_children
fi

# A clean but unexpected child exit still requires Supervisor to restart us.
if (( status == 0 )); then
  status=1
fi
exit "$status"
